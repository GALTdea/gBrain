{
  "name": "Second Brain",
  "short_name": "SecondBrain",
  "description": "Frictionless personal knowledge base and second brain for Gustavo & Gianna",
  "start_url": "/dashboard",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#ECEFF4",
  "theme_color": "#5E81AC",
  "icons": [
    {
      "src": "/icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/capture-share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "audio",
          "accept": ["audio/*", ".m4a", ".mp3", ".wav", ".aac", ".webm", ".ogg"]
        }
      ]
    }
  },
  "shortcuts": [
    {
      "name": "Instant Voice Note",
      "short_name": "Voice Note",
      "description": "Start recording a voice thought immediately",
      "url": "/capture?mode=voice&autostart=1",
      "icons": [
        {
          "src": "/icons/icon-192.svg",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Quick Text Capture",
      "short_name": "Capture",
      "description": "Jot down a quick thought or link",
      "url": "/capture",
      "icons": [
        {
          "src": "/icons/icon-192.svg",
          "sizes": "192x192"
        }
      ]
    }
  ]
}

